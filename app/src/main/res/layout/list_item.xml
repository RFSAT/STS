<?xml version="1.0" encoding="utf-8"?>
<!-- Replaces android.R.layout.simple_list_item_1 so the target and rule
     lists take the app's own text colour rather than the platform default,
     which is not guaranteed to contrast with a custom window background. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/text1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:textSize="15sp"
    android:textColor="?android:attr/textColorPrimary"
    android:lineSpacingExtra="0dp"
    android:minHeight="0dp"
    android:gravity="center_vertical" />

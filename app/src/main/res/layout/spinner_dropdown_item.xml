<?xml version="1.0" encoding="utf-8"?>
<!-- Replaces android.R.layout.simple_spinner_dropdown_item, for the same
     reason as spinner_item: the platform version is coloured for the inverse
     of the current theme. The popup is drawn on colorSurface, so the text
     takes textColorPrimary to match every other surface in the app. -->
<CheckedTextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/text1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="42dp"
    android:background="?attr/colorSurface"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:textSize="15sp"
    android:textColor="?android:attr/textColorPrimary"
    android:gravity="center_vertical"
    android:checkMark="?android:attr/listChoiceIndicatorSingle"
    android:ellipsize="marquee"
    android:singleLine="true" />

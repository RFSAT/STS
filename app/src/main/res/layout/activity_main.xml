<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginBottom="8dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@string/app_name" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:layout_marginBottom="16dp" />

            <!-- Active setup: the one thing a shooter must confirm before
                 firing, so it is the first thing on the screen. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Active setup"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorAccent" />

                <!-- A two-column table, not a padded string.

                     The setup used to be one TextView with the labels padded
                     out with spaces, which only lines the colons up in a
                     monospaced font — in the app's proportional face they
                     wandered by several characters. A table aligns them by
                     construction, at any font size and in any language. -->
                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:shrinkColumns="2">

                    <TableRow>
                        <TextView style="@style/Sts.SetupLabel" android:text="Profile set" />
                        <TextView style="@style/Sts.SetupColon" />
                        <TextView android:id="@+id/tvSetupSet" style="@style/Sts.SetupValue" />
                    </TableRow>
                    <TableRow>
                        <TextView style="@style/Sts.SetupLabel" android:text="Firearm" />
                        <TextView style="@style/Sts.SetupColon" />
                        <TextView android:id="@+id/tvSetupRifle" style="@style/Sts.SetupValue" />
                    </TableRow>
                    <TableRow>
                        <TextView style="@style/Sts.SetupLabel" android:text="Load" />
                        <TextView style="@style/Sts.SetupColon" />
                        <TextView android:id="@+id/tvSetupLoad" style="@style/Sts.SetupValue" />
                    </TableRow>
                    <TableRow>
                        <TextView style="@style/Sts.SetupLabel" android:text="Sight" />
                        <TextView style="@style/Sts.SetupColon" />
                        <TextView android:id="@+id/tvSetupSight" style="@style/Sts.SetupValue" />
                    </TableRow>
                    <TableRow>
                        <TextView style="@style/Sts.SetupLabel" android:text="Target" />
                        <TextView style="@style/Sts.SetupColon" />
                        <TextView android:id="@+id/tvSetupTarget" style="@style/Sts.SetupValue" />
                    </TableRow>
                    <TableRow>
                        <TextView style="@style/Sts.SetupLabel" android:text="Rules" />
                        <TextView style="@style/Sts.SetupColon" />
                        <TextView android:id="@+id/tvSetupRules" style="@style/Sts.SetupValue" />
                    </TableRow>
                    <TableRow>
                        <TextView style="@style/Sts.SetupLabel" android:text="Distance" />
                        <TextView style="@style/Sts.SetupColon" />
                        <TextView android:id="@+id/tvSetupDistance" style="@style/Sts.SetupValue" />
                    </TableRow>
                </TableLayout>

                <TextView
                    android:id="@+id/tvSetupNote"
                    style="@style/Sts.Value"
                    android:layout_marginTop="10dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    style="@style/Sts.ActionButton"
                    android:text="Diagnostic log" />

                <Button
                    android:id="@+id/btnResume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:visibility="gone"
                    style="@style/Sts.ActionButton"
                    android:text="Resume the session in progress" />
            </LinearLayout>

            <TextView
                style="@style/Sts.SectionHeading"
                android:text="What this app does" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:textColor="?android:attr/textColorPrimary"
                android:text="@string/about_app_description"
                android:justificationMode="inter_word" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:textColor="?android:attr/textColorSecondary"
                android:text="@string/about_disciplines"
                android:justificationMode="inter_word" />

            <TextView
                style="@style/Sts.SectionHeading"
                android:text="Before you rely on a score" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:textColor="?android:attr/textColorSecondary"
                android:text="@string/disclaimer_scoring"
                android:justificationMode="inter_word" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:textColor="?android:attr/textColorSecondary"
                android:text="@string/safety_notice"
                android:justificationMode="inter_word" />

            <TextView
                style="@style/Sts.SectionHeading"
                android:text="@string/about_developer_heading" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:textColor="?android:attr/textColorPrimary"
                android:text="@string/about_developer_description"
                android:justificationMode="inter_word" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="13sp"
                android:text="developed by Dr Artur Krukowski" />

            <TextView
                android:id="@+id/tvClaudeCredit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp" />

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/include_bottom_nav" />

</LinearLayout>

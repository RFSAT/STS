<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base: attributes shared by all four modes -->
    <style name="Theme.STS.Base" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:statusBarColor">@color/dark_bg</item>
    </style>

    <!-- Dark: the default. Dark pixels draw less power on OLED and suit
         low light on the firing point. -->
    <style name="Theme.STS.Dark" parent="Theme.STS.Base">
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorPrimary">@color/dark_accent</item>
        <item name="colorSecondary">@color/dark_accent</item>
        <item name="colorAccent">@color/dark_accent</item>
        <item name="colorOnPrimary">@color/dark_on_accent</item>
        <item name="colorOnSecondary">@color/dark_on_accent</item>
        <item name="android:colorBackground">@color/dark_surface</item>
        <item name="android:textColorPrimary">@color/dark_text</item>
        <item name="android:textColorSecondary">@color/dark_text_dim</item>
        <item name="android:textColorTertiary">#C9D4C6</item>
        <item name="android:textColorHint">#A6B2A4</item>
        <item name="colorOnSurface">@color/dark_text</item>
        <item name="colorOnBackground">@color/dark_text</item>
    </style>

    <!-- Day: bright, high contrast for direct-sunlight legibility -->
    <style name="Theme.STS.Day" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@color/day_bg</item>
        <item name="colorSurface">@color/day_surface</item>
        <item name="colorPrimary">@color/day_accent</item>
        <item name="colorSecondary">@color/day_accent</item>
        <item name="colorAccent">@color/day_accent</item>
        <item name="colorOnPrimary">@color/day_on_accent</item>
        <item name="colorOnSecondary">@color/day_on_accent</item>
        <item name="android:colorBackground">@color/day_surface</item>
        <item name="android:textColorPrimary">@color/day_text</item>
        <item name="android:textColorSecondary">@color/day_text_dim</item>
        <item name="android:textColorTertiary">#3D4A3D</item>
    </style>

    <!-- Night Green: monochrome green on black -->
    <style name="Theme.STS.NightGreen" parent="Theme.STS.Base">
        <item name="android:windowBackground">@color/ngreen_bg</item>
        <item name="colorSurface">@color/ngreen_surface</item>
        <item name="colorPrimary">@color/ngreen_accent</item>
        <item name="colorSecondary">@color/ngreen_accent</item>
        <item name="colorAccent">@color/ngreen_accent</item>
        <item name="colorOnPrimary">@color/ngreen_on_accent</item>
        <item name="colorOnSecondary">@color/ngreen_on_accent</item>
        <item name="android:colorBackground">@color/ngreen_surface</item>
        <item name="android:textColorPrimary">@color/ngreen_text</item>
        <item name="android:textColorSecondary">@color/ngreen_text_dim</item>
        <item name="android:textColorTertiary">#2BB82B</item>
        <item name="android:textColorHint">#1FA31F</item>
        <item name="colorOnSurface">@color/ngreen_text</item>
        <item name="colorOnBackground">@color/ngreen_text</item>
    </style>

    <!-- Night Red: monochrome red on black — preserves night vision best -->
    <style name="Theme.STS.NightRed" parent="Theme.STS.Base">
        <item name="android:windowBackground">@color/nred_bg</item>
        <item name="colorSurface">@color/nred_surface</item>
        <item name="colorPrimary">@color/nred_accent</item>
        <item name="colorSecondary">@color/nred_accent</item>
        <item name="colorAccent">@color/nred_accent</item>
        <item name="colorOnPrimary">@color/nred_on_accent</item>
        <item name="colorOnSecondary">@color/nred_on_accent</item>
        <item name="android:colorBackground">@color/nred_surface</item>
        <item name="android:textColorPrimary">@color/nred_text</item>
        <item name="android:textColorSecondary">@color/nred_text_dim</item>
        <item name="android:textColorTertiary">#C93A3A</item>
        <item name="android:textColorHint">#A62A2A</item>
        <item name="colorOnSurface">@color/nred_text</item>
        <item name="colorOnBackground">@color/nred_text</item>
    </style>

    <!-- Manifest default points here; BaseActivity swaps at runtime -->
    <style name="Theme.STS" parent="Theme.STS.Dark" />

    <!-- Shared widget styles so every screen looks the same without
         repeating six attributes per view. -->
    <style name="Sts.SectionHeading" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <!-- 19sp: these head the settings screen and were competing with the
             body text they introduce rather than standing above it. -->
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">?attr/colorAccent</item>
    </style>

    <style name="Sts.FieldLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <!-- Borderless buttons.

         "?android:attr/borderlessButtonStyle" asks for the PLATFORM style,
         whose text colour comes from the platform's own attributes rather
         than from anything this app sets — so under the dark themes every one
         of the 35 borderless buttons rendered near-black on a dark
         background: the Home screen's log and resume, everything under
         Elsewhere in Settings, the undo and reset and clear actions on every
         other screen. Setting textColor here, on a style applied directly to
         the view, is the one place the platform cannot override.

         colorAccent rather than textColorPrimary, so a text button reads as
         an action in all four themes: gold on dark, dark green on white,
         and the monochrome accent in each night mode. -->
    <style name="Sts.TextButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">?attr/colorAccent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- A real, visibly raised button.

         Sts.TextButton renders as flat coloured text, and the shot-editing
         controls used it: "Add shot", "Move shots", "Show whole card" and
         "Reset view" all looked like labels rather than things to press, and
         went unnoticed. The same mistake had already been reported once for
         the photo-import entry points. Anything that PERFORMS an action gets
         this; Sts.TextButton is now only for genuinely secondary links. -->
    <style name="Sts.ActionButton" parent="Widget.AppCompat.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
    </style>

    <!-- A button in a row of equal buttons. Fixed height so a label that
         wraps cannot make one taller than its neighbours, equal weight so
         they are all the same width. -->
    <style name="Sts.GridButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Sts.Value" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>

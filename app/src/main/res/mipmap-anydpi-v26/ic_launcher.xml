<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon.

     The foreground is a bitmap rather than a vector, deliberately. The
     artwork carries a numeral, and VectorDrawable has no text element — a
     vector version would mean converting glyph outlines to paths by hand and
     maintaining them separately from the 512 px Play asset, which is exactly
     how a store listing and a home screen drift apart. One generator
     (tools/generate_icons.py) emits both from the same drawing.

     The monochrome layer is the same artwork as a flat silhouette, for
     Android 13+ themed icons; the system tints it by the wallpaper palette
     and uses only its alpha, so the bullet holes have to be genuinely
     transparent rather than merely background-coloured. They are. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
